+"""Verify the test infrastructure fails closed instead of hiding source changes."""
+from pathlib import Path
+import pytest
+import historical_source as h
+
+
+@pytest.mark.parametrize('old,new', sorted(h.MOVED.items()))
+def test_relocations_are_explicit_and_resolve_to_real_native_source(old,new):
+    assert not (h.ROOT/old).exists()
+    assert (h.ROOT/new).is_file()
+    assert h.canonical_path(h.ROOT/old) == h.ROOT/new
+    assert h.read_source(h.ROOT/old) == (h.ROOT/new).read_text()
+
+
+def test_unknown_file_is_not_redirected_or_synthesized(tmp_path):
+    missing=tmp_path/'fn_unknown.sqf'
+    with pytest.raises(FileNotFoundError):h.read_source(missing)
+    assert not missing.exists()
+
+
+def test_global_path_reader_is_not_modified():
+    assert Path.read_text.__module__.split('.')[0] == 'pathlib'
+
+
+def test_startup_follows_real_calls_once_and_ignores_comments_and_strings(tmp_path):
+    (tmp_path/'fn_postInit.sqf').write_text('call ACME_fnc_initOne; call ACME_fnc_initOne; // call ACME_fnc_initMissing;\n"call ACME_fnc_registerMissing;";')
+    (tmp_path/'fn_initOne.sqf').write_text('call ACME_fnc_registerTwo; A = 1;')
+    (tmp_path/'fn_registerTwo.sqf').write_text('call ACME_fnc_initOne; B = 2;')
+    result=h.source_bundle(tmp_path/'fn_postInit.sqf')
+    assert [p.name for p,t in result] == ['fn_postInit.sqf','fn_initOne.sqf','fn_registerTwo.sqf']
+    assert len([t for _,t in result if 'B = 2' in t]) == 1
+
+
+def test_missing_called_module_fails_instead_of_skipping_it(tmp_path):
+    entry=tmp_path/'fn_postInit.sqf';entry.write_text('call ACME_fnc_initMissing;')
+    with pytest.raises(FileNotFoundError):h.source_bundle(entry)
+
+
+def test_non_startup_reader_does_not_expand_unrelated_gameplay_helpers(tmp_path):
+    entry=tmp_path/'fn_anAction.sqf';entry.write_text('call ACME_fnc_initMissing;')
+    assert h.read_source(entry) == entry.read_text()
+
