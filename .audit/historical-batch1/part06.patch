+    (addon/'config.cpp').write_text('class CfgPatches {class ACM_Extended {version = "'+version+'";};};')
+    (addon/'functions/fn_postInit.sqf').write_text('call ACME_fnc_initVersion;')
+    (addon/'functions/fn_initVersion.sqf').write_text(
+        'ACME_infusion_version = getText (configFile >> "CfgPatches" >> "ACM_Extended" >> "version");\n'
+        'if (ACME_infusion_version == "") then { ACME_infusion_version = "'+fallback+'"; };\n'
+        'ACME_buildBatch = "'+batch+'";')
+
+
