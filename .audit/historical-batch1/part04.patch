+def test_each_startup_module_has_balanced_delimiters():
+    pairs = {')': '(', ']': '[', '}': '{'}
+    for path, text in source_bundle(POST):
+        stack = []
+        for token in lex(text):
+            if token.kind != 'symbol':
+                continue
+            if token.value in ('(', '[', '{'):
+                stack.append(token.value)
+            elif token.value in pairs:
