+def canonical_path(path: Path) -> Path:
+    path = Path(path).resolve()
+    if path.exists():
+        return path
+    try:
+        relative = path.relative_to(ROOT).as_posix()
+    except ValueError:
+        return path
+    return ROOT / MOVED[relative] if relative in MOVED else path
+
+
+def _modules(path: Path, visited: set[Path], *, startup: bool) -> list[tuple[Path, str]]:
+    if path in visited:
+        return []
+    visited.add(path)
+    text = path.read_text(encoding="utf-8-sig")
+    result = [(path, text)]
+    tokens = lex(text)
+    for index, token in enumerate(tokens[:-1]):
+        target = tokens[index + 1]
+        if token.kind != "ident" or token.value != "call" or target.kind != "ident":
+            continue
+        prefixes = ("ACME_fnc_init", "ACME_fnc_register") if startup else ("ACME_fnc_debugMenu",)
+        if not target.value.startswith(prefixes):
+            continue
+        name = target.value.removeprefix("ACME_fnc_")
+        child = path.parent / ("fn_" + name + ".sqf")
+        # Fail closed when a called source is missing; never silently omit a dependency.
+        result.extend(_modules(child, visited, startup=startup))
+    return result
+
+
+def source_bundle(path: Path) -> list[tuple[Path, str]]:
+    path = canonical_path(path)
+    if path.name not in ("fn_postInit.sqf", "fn_debugMenu.sqf"):
+        return [(path, path.read_text(encoding="utf-8-sig"))]
+    return _modules(path, set(), startup=path.name == "fn_postInit.sqf")
+
+
+def read_source(path: Path, *args, **kwargs) -> str:
+    path = canonical_path(path)
+    if path.name in ("fn_postInit.sqf", "fn_debugMenu.sqf"):
+        return "\n".join(text for _, text in source_bundle(path))
+    return path.read_text(*args, **kwargs)
+
