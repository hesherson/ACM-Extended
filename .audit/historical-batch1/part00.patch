+def switch_case_body(text: str, name: str) -> str:
+    """Extract one actual named switch branch, rejecting missing/ambiguous cases."""
+    tokens=lex(text); pairs=matching(tokens)
+    starts=[i+3 for i in range(len(tokens)-3)
+            if tokens[i].value=='case' and tokens[i+1].kind=='string'
+            and tokens[i+1].value==name and tokens[i+2].value==':' and tokens[i+3].value=='{']
+    assert len(starts)==1, (name,starts)
+    i=starts[0]
+    assert i in pairs, name
+    return text[tokens[i].offset+1:tokens[pairs[i]].offset]
