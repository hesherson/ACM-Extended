+def assert_release_identity(root: Path = ROOT) -> None:
+    """Check the shipped config/runtime identity, not a retired batch's literal."""
+    import re
+    from medication_inventory import subtree
+    addon = root / "addons/acm_extended"
+    cfg = subtree((addon / "config.cpp").read_text(encoding="utf-8-sig"), "CfgPatches")
+    version = cfg["classes"]["ACM_Extended"]["props"]["version"]
+    assert re.fullmatch(r"[0-9]+(?:\.[0-9]+){2,3}(?:[-+][A-Za-z0-9.-]+)?", version), version
+    startup = read_source(addon / "functions/fn_postInit.sqf")
+    assert 'ACME_infusion_version = getText (configFile >> "CfgPatches" >> "ACM_Extended" >> "version");' in startup
+    fallbacks = re.findall(r'ACME_infusion_version\s*=\s*"([^"]+)"', startup)
+    assert fallbacks == [version], (version, fallbacks)
+    batches = re.findall(r'ACME_buildBatch\s*=\s*"([^"]+)"', startup)
+    assert len(batches) == 1 and re.fullmatch(r"B[0-9]+(?:[-+][A-Za-z0-9.-]+)?", batches[0]), batches
