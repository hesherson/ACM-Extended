+    CBA settings/fnc_init.sqf documents 1 as shared and 2 as not overwritable.
+    Both direct addSetting declarations and preInit's settings array use this shape.
+    """
+    tokens=lex(text); pairs=matching(tokens); declarations=[]
+    for i,t in enumerate(tokens[:-1]):
+        if t.kind!='symbol' or t.value!='[' or i not in pairs:continue
+        args=split_args(tokens,i+1,pairs[i],pairs)
+        if (len(args)>=6 and len(args[0])==1 and args[0][0].kind=='string'
+            and args[0][0].value==name and len(args[1])==1
+            and args[1][0].value in ('CHECKBOX','LIST','SLIDER','COLOR','EDITBOX','TIME')):
+            declarations.append(args)
+    assert len(declarations)==1,(name,len(declarations))
+    scope=declarations[0][5]
+    assert len(scope)==1 and scope[0].kind=='number' and scope[0].value=='2', (name,scope)
