// HRS-I outside: crinkled coyote laminate with ripstop. Tiles every 0.60 m.
// (The real shell is a dark coyote olive. Tried in game, five materials side by side: how dark the cloth looks
// follows its picture's own middle value, not shine or reflection; the picture was darkened for it.)
ambient[] = {0.82, 0.82, 0.80, 1};
diffuse[] = {0.82, 0.82, 0.80, 1};
forcedDiffuse[] = {0, 0, 0, 0};
emmisive[] = {0, 0, 0, 1};
specular[] = {0.16, 0.15, 0.13, 1};
specularPower = 45;
PixelShaderID = "Super";
VertexShaderID = "Super";
class Stage1 {
    texture = "acme_hpmk\data\hpmk_out_nohq.paa";
    uvSource = "tex";
    class uvTransform { aside[] = {1, 0, 0}; up[] = {0, 1, 0}; dir[] = {0, 0, 0}; pos[] = {0, 0, 0}; };
};
class Stage2 {
    texture = "#(argb,8,8,3)color(0.5,0.5,0.5,0.5,DT)";
    uvSource = "tex";
    class uvTransform { aside[] = {1, 0, 0}; up[] = {0, 1, 0}; dir[] = {0, 0, 0}; pos[] = {0, 0, 0}; };
};
class Stage3 {
    texture = "#(argb,8,8,3)color(0,0,0,0,MC)";
    uvSource = "tex";
    class uvTransform { aside[] = {1, 0, 0}; up[] = {0, 1, 0}; dir[] = {0, 0, 0}; pos[] = {0, 0, 0}; };
};
class Stage4 {
    texture = "#(argb,8,8,3)color(1,1,1,1,AS)";
    uvSource = "tex";
    class uvTransform { aside[] = {1, 0, 0}; up[] = {0, 1, 0}; dir[] = {0, 0, 0}; pos[] = {0, 0, 0}; };
};
class Stage5 {
    texture = "acme_hpmk\data\hpmk_out_smdi.paa";
    uvSource = "tex";
    class uvTransform { aside[] = {1, 0, 0}; up[] = {0, 1, 0}; dir[] = {0, 0, 0}; pos[] = {0, 0, 0}; };
};
class Stage6 {
    texture = "#(ai,32,128,1)fresnel(1.5,0.2)";
    uvSource = "none";
};
class Stage7 {
    texture = "a3\data_f\env_land_co.paa";
